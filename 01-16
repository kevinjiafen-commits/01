local TabConfig = Window:CreateTab("Config", "settings")

TabConfig:CreateSection("Save/Load Configuration")

local configInput = TabConfig:CreateInput({
    Name = "Config Data",
    PlaceholderText = "Paste or copy config JSON here",
    RemoveTextAfterFocusLost = false,
    Flag = "Input_ConfigData",
})

TabConfig:CreateButton({
    Name = "Export Config",
    Callback = function()
        local cfg = getFullConfig()
        local json = HttpService:JSONEncode(cfg)
        configInput:Set(json)
        Rayfield:Notify({Title = "Config", Content = "Configuration exported to text field.", Duration = 3})
    end,
})

TabConfig:CreateButton({
    Name = "Import Config",
    Callback = function()
        local json = configInput:Get()
        if json and json ~= "" then
            local success, cfg = pcall(HttpService.JSONDecode, HttpService, json)
            if success and type(cfg) == "table" then
                setFullConfig(cfg)
                Rayfield:Notify({Title = "Config", Content = "Configuration loaded successfully.", Duration = 3})
            else
                Rayfield:Notify({Title = "Error", Content = "Invalid config JSON.", Duration = 3})
            end
        end
    end,
})

TabConfig:CreateButton({
    Name = "Reset to Default",
    Callback = function()
        setFullConfig(defaultConfigValues)
        configInput:Set("")
        Rayfield:Notify({Title = "Config", Content = "All settings reset to defaults.", Duration = 3})
    end,
})

